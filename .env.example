# Supabase project (Settings -> API in the Supabase dashboard).
# These are read-only, public-safe values — this site only ever SELECTs
# published blog posts using the anon key, which Row Level Security
# restricts (see project.sql). Never put the service-role key here; that
# key bypasses RLS and this repo/site is public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
